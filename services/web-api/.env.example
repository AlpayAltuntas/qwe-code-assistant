# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Local Postgres.app instance — a dedicated low-privilege role, not a superuser.
DATABASE_URL=postgres://qwe_web_api:CHANGE_ME@127.0.0.1:5432/qwe_web_ui

# Loopback only — see docs/threat-model.md S1.
HOST=127.0.0.1
PORT=8788

# Absolute path to services/mcp-server (this repo's copy). The API spawns
# `uv run --directory <this> edi-mcp-server` per tool call, same as Continue.
MCP_SERVER_DIR=/absolute/path/to/services/mcp-server

# Origins allowed to call this API (see docs/threat-model.md S3 — no
# wildcard, this is what stops a "localhost drive-by" from another tab).
CORS_ORIGIN=http://127.0.0.1:5173
